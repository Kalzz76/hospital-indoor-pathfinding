<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/vite.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>s1pf</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        /* Menghapus overflow: hidden agar scrollbar muncul */
      }



      #gm {
        position: absolute; /* Gunakan absolute, bukan fixed agar ikut tergulung */
        top: 0;
        left: 0;
        width: 100%;       /* Lebar penuh mengikuti layar */
        height: auto;      /* Tinggi otomatis sesuai proporsi gambar asli */
        z-index: -1;       /* Tetap di belakang elemen lain */
        display: block;    /* Menghilangkan celah kecil di bawah gambar */
      }

      /* Pastikan container app atau canvas tidak menutupi scroll */
      #app, #canvas {
        position: relative;
        left: 262px;
        top: 95px;
        z-index: 1;
      }
    </style>
  </head>
  <body>
    <div id="app"></div>
    <img src="/maps.jpeg" alt="" id="gm">
    <canvas id="canvas"></canvas>
    <script type="module" src="/src/main.js"></script>
  </body>
</html>
